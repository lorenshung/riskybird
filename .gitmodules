# Backends are initialised per tier, never with --recursive: each carries its
# own nested submodules, and recursing pulls several gigabytes including three
# separate copies of Chipyard. Initialise only what the tier you want needs.
#
#   bench tier    git submodule update --init backends/zephyr-chipyard-sw
#   silicon tier  ... plus backends/chipyard   (Linux only; needs Vivado)
#   models        ... plus backends/modelblaster  (~143 MiB)
#
# backends/modelblaster remains the path used by `rb modelblaster`. The merged
# Zephyr backend also uses a nested ModelBlaster checkout; both select the same
# commit. Consolidating the caller paths is a separate tested change.
#
# hardware/pcb is the board itself (KiCad), checked in as a plain directory.
# Its one nested submodule, gym-pybullet-drones under riskybird-academy, is
# listed below and is not part of any tier.
[submodule "backends/zephyr-chipyard-sw"]
	path = backends/zephyr-chipyard-sw
	url = https://github.com/lorenshung/zephyr-chipyard-sw.git
	branch = integration/riskybird-20260928
[submodule "backends/chipyard"]
	path = backends/chipyard
	url = https://github.com/lorenshung/chipyard.git
	branch = integration
[submodule "backends/modelblaster"]
	path = backends/modelblaster
	url = https://github.com/lorenshung/ModelBlaster.git
	branch = integration/riskybird-20260928
[submodule "hardware/pcb/riskybird-academy/sim/gym-pybullet-drones"]
	path = hardware/pcb/riskybird-academy/sim/gym-pybullet-drones
	url = https://github.com/ucb-bar/gym-pybullet-drones.git
