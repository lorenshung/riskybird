From e564842b14c4e96a1c8fbb9c4f63419f1edb5036 Mon Sep 17 00:00:00 2001
From: Loren Hung <lorenhung@berkeley.edu>
Date: Wed, 9 Sep 2026 19:48:18 -0700
Subject: [PATCH] rose_flight_controller: ROSE_ESTIMATOR_ONLY, to test the
 estimator alone

Adds one build knob, default 0, that makes solve_control() return a zero
command without calling ctrl.compute().

The reason is measured, not hypothetical. Running this sample on the RiskyBird
FPGA carrier for the first time, the loop ran at dt=23ms (183 of 203 samples)
against the ~1kHz it is written for, altitude drifted from -150 to -39 with no
valid down-ToF reading, and the four commands climbed monotonically from 115 to
139 -- three symptoms that read like a controller fault. They are one cause and
one consequence: with no height reference the estimator's z dead-reckons off
accel, and the controller faithfully winds up chasing it.

With the controller compiled out the same board gives dt of 1-5ms (266 samples
at 5ms, 234 at 1ms over a 500-sample run), so the 23ms was TinyMPC's solve and
not the sensors or the estimator. That is worth knowing before anyone tunes the
loop rate on this target.

The estimator itself measures well there: roll -0.0 to 0.9 deg, pitch 0.0 to
0.9, yaw -0.0 to 0.5 over 500 samples on a stationary bench, and u stayed
exactly zero for all 500 -- so the knob does what it says.

Actuation is separately impossible in such a build: main only drives PWM when
the `motors` alias exists.
---
 samples/rose_flight_controller/CMakeLists.txt |  4 ++++
 samples/rose_flight_controller/src/main.cpp   | 19 +++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/samples/rose_flight_controller/CMakeLists.txt b/samples/rose_flight_controller/CMakeLists.txt
index 7f4dd183572..58a6e7a84c9 100644
--- a/samples/rose_flight_controller/CMakeLists.txt
+++ b/samples/rose_flight_controller/CMakeLists.txt
@@ -38,6 +38,9 @@ set(ROSE_USE_PID 0 CACHE STRING "1=hierarchical PID, 0=TinyMPC")
 # ROSE_CTRL_DIV (control runs every Nth estimator tick -> control rate = estimation / N).
 set(ROSE_THREADED 0 CACHE STRING "1=threaded blocks, 0=single loop (default; see main.cpp note)")
 set(ROSE_CTRL_DIV 1 CACHE STRING "control every Nth estimator tick (multi-rate)")
+# Estimator-only: run sensors + estimator + telemetry and never call the
+# controller. For characterising the estimator by itself; see solve_control().
+set(ROSE_ESTIMATOR_ONLY 0 CACHE STRING "1=estimator only (controller never runs)")
 # Bench safety: stop driving motors this many ms after boot (0 = never). Real-HW bench
 # bring-up builds with 10000 so the props auto-stop 10 s after reset. Keep 0 for flight.
 set(ROSE_ACTUATE_TIMEOUT_MS 0 CACHE STRING "stop motor actuation N ms after boot (0=never)")
@@ -85,6 +88,7 @@ target_compile_definitions(app PRIVATE ROSE_USE_EKF=${ROSE_USE_EKF}
   ROSE_THREADED=${ROSE_THREADED} ROSE_CTRL_DIV=${ROSE_CTRL_DIV}
   ROSE_ACTUATE_TIMEOUT_MS=${ROSE_ACTUATE_TIMEOUT_MS} CTRL_ITERS=${CTRL_ITERS}
   ROSE_BUMPER=${ROSE_BUMPER} ROSE_FLOW=${ROSE_FLOW} ROSE_BARO=${ROSE_BARO}
+  ROSE_ESTIMATOR_ONLY=${ROSE_ESTIMATOR_ONLY}
   ROSE_BUMPER_READDRESS_ONLY=${ROSE_BUMPER_READDRESS_ONLY})
 
 target_include_directories(app PRIVATE
diff --git a/samples/rose_flight_controller/src/main.cpp b/samples/rose_flight_controller/src/main.cpp
index 042e7d7eeb2..46813947c1b 100644
--- a/samples/rose_flight_controller/src/main.cpp
+++ b/samples/rose_flight_controller/src/main.cpp
@@ -1220,7 +1220,26 @@ static bool read_sensor_frame(struct sensor_frame *f)
  * REAL measured loop period (s) -- pass the same value used for est.update so time bases match. */
 static void solve_control(const float *state, float *u, float dt)
 {
+#if defined(ROSE_ESTIMATOR_ONLY) && ROSE_ESTIMATOR_ONLY
+	/*
+	 * Estimator-only build: the controller is never asked for a command.
+	 *
+	 * This exists so the estimator can be judged on its own. With the
+	 * controller in the loop on a bench-stationary drone, a starved
+	 * altitude estimate (down-ToF invalid -> z dead-reckons off accel)
+	 * makes the controller wind up chasing it, and the telemetry line then
+	 * shows a ramping u[] on top of a drifting z -- two symptoms of one
+	 * cause, which reads like a controller fault and is not. Forcing u to
+	 * zero here leaves exactly one thing under test.
+	 *
+	 * Actuation is separately impossible in this build: main only drives
+	 * PWM when the `motors` alias exists, and it does not here.
+	 */
+	(void)state; (void)dt;
+	for (int i = 0; i < NACTIONS; i++) { u[i] = 0.0f; }
+#else
 	ctrl.compute(state, g_setpoint, u, dt);
+#endif
 }
 
 #if ROSE_THREADED
-- 
2.43.0

