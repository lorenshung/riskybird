+  // space (0-19, 24-26 and 28-31 are taken); four ops take four of them, and 27
+  // is left for a fifth.
+  def FN_PDOT8  = 20.U
+  def FN_PMAX8  = 21.U
+  def FN_PQMUL  = 22.U
+  def FN_PCLIP8 = 23.U
