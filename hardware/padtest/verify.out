PAD motor1:
    PACKAGE_PIN = E22   IOSTANDARD = LVCMOS33   PULLTYPE = PULLDOWN   DIRECTION = OUT
    OBUF        = motor1_OBUF_inst  REF_NAME = OBUF
    OBUF LOC    = IOB_X0Y206   SITE = IOB_X0Y206   BEL = IOB33.OUTBUF
    DRIVER      = motor1_q_reg  REF_NAME = FDRE  INIT = 1'b0
    DRIVER LOC  = OLOGIC_X0Y206   BEL = OLOGICE2.OUTFF
    ROUTE       = ROUTED

PAD motor2:
    PACKAGE_PIN = B20   IOSTANDARD = LVCMOS33   PULLTYPE = PULLDOWN   DIRECTION = OUT
    OBUF        = motor2_OBUF_inst  REF_NAME = OBUF
    OBUF LOC    = IOB_X0Y218   SITE = IOB_X0Y218   BEL = IOB33.OUTBUF
    DRIVER      = motor2_q_reg  REF_NAME = FDRE  INIT = 1'b0
    DRIVER LOC  = OLOGIC_X0Y218   BEL = OLOGICE2.OUTFF
    ROUTE       = ROUTED

PAD motor3:
    PACKAGE_PIN = R17   IOSTANDARD = LVCMOS33   PULLTYPE = PULLDOWN   DIRECTION = OUT
    OBUF        = motor3_OBUF_inst  REF_NAME = OBUF
    OBUF LOC    = IOB_X0Y101   SITE = IOB_X0Y101   BEL = IOB33.OUTBUF
    DRIVER      = motor3_q_reg  REF_NAME = FDRE  INIT = 1'b0
    DRIVER LOC  = OLOGIC_X0Y101   BEL = OLOGICE2.OUTFF
    ROUTE       = ROUTED

PAD motor4:
    PACKAGE_PIN = F13   IOSTANDARD = LVCMOS33   PULLTYPE = PULLDOWN   DIRECTION = OUT
    OBUF        = motor4_OBUF_inst  REF_NAME = OBUF
    OBUF LOC    = IOB_X0Y248   SITE = IOB_X0Y248   BEL = IOB33.OUTBUF
    DRIVER      = motor4_q_reg  REF_NAME = FDRE  INIT = 1'b0
    DRIVER LOC  = OLOGIC_X0Y248   BEL = OLOGICE2.OUTFF
    ROUTE       = ROUTED

