/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Optional four-VL53L5CX ranging devices. Shared I2C wiring and bitrate come
 * from the ESP target contract.
 */

&i2c0 {
	/* Final unique addresses after reprogramming (see sample logic). */
	vl53l5cx0: vl53l5cx@31 {
		compatible = "st,vl53l5cx";
		reg = <0x31>;
		status = "okay";
	};

	vl53l5cx1: vl53l5cx@32 {
		compatible = "st,vl53l5cx";
		reg = <0x32>;
		status = "okay";
	};

	vl53l5cx2: vl53l5cx@33 {
		compatible = "st,vl53l5cx";
		reg = <0x33>;
		status = "okay";
	};

	vl53l5cx3: vl53l5cx@34 {
		compatible = "st,vl53l5cx";
		reg = <0x34>;
		status = "okay";
	};
};

/ {
	/* Define aliases for easier access in code */
	aliases {
		tof0 = &vl53l5cx0;
		tof1 = &vl53l5cx1;
		tof2 = &vl53l5cx2;
		tof3 = &vl53l5cx3;
	};
};
