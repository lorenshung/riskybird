# RiskyBird flight preset 't16-hover-0.6m' -- exactly the build flags that flew: T14 T16 (7.3-7.7 s airborne at 0.6 m, drift <0.5 m)
# Source: flight-logs trials; see docs/flight-presets.md. Build: rb build flight_controller --target arty200t
#   --config RocketArty200TDroneFullDDRConfig --mode esp-motors, with these two variables exported.
export RB_CMAKE_ARGS="-DROSE_AUTOFLIGHT=1 -DROSE_ARM_NO_GESTURE=1 -DROSE_UART_CMD=1 -DROSE_FLIGHT_COMMIT=1 -DROSE_COMMIT_MAX_MS=60000 -DAUTOFLIGHT_MAX_DUTY=0.95f -DPID_MASS_KG=0.050f -DARM_MAX_HEIGHT_M=0.05f -DHOVER_Z_M=0.60f -DROSE_TELEM_DIV=40 -DROSE_BATT_REPORT_ONLY=0"
export RB_EXTRA_CPPFLAGS="-DT_CLIMB_MS=2500 -DT_HOVER_MS=2000 -DT_DESCEND_MS=2500 -DFLIGHT_MAX_MS=10000 -DARM_MAX_TILT_RAD=0.087f -DROSE_TELEM_CONSOLE=0 -DFLOW_LP_TAU_X=0.05f -DFLOW_LP_TAU_Y=0.15f -DVL53L1X_TIMING_BUDGET_US=100000 -DIMU_OFFSET_Y=0.016f -DSAFE_MAX_HEIGHT_M=1.2f -DSAFE_MAX_VEL_MPS=2.0f -DBATT_CUTOFF_V=3.0f -DYAW_AUTH_FRAC=0.15f -DROSE_VEL_LOOP=1 -DVEL_TILT_MAX=0.08f -DMOTOR_TRIM_LEFT=1.0f"
