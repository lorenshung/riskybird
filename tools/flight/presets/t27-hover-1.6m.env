# RiskyBird flight preset 't27-hover-1.6m' -- exactly the build flags that flew: T27 (clean climb + hold at 1.6 m; lost on descent after a pass over a desk; FR motor damaged after this)
# Source: flight-logs trials; see docs/flight-presets.md. Build: rb build flight_controller --target arty200t
#   --config RocketArty200TDroneFullDDRConfig --mode esp-motors, with these two variables exported.
export RB_CMAKE_ARGS="-DROSE_AUTOFLIGHT=1 -DROSE_ARM_NO_GESTURE=1 -DROSE_UART_CMD=1 -DROSE_FLIGHT_COMMIT=1 -DROSE_COMMIT_MAX_MS=60000 -DAUTOFLIGHT_MAX_DUTY=0.95f -DPID_MASS_KG=0.050f -DARM_MAX_HEIGHT_M=0.05f -DHOVER_Z_M=1.60f -DROSE_TELEM_DIV=40 -DROSE_BATT_REPORT_ONLY=0"
export RB_EXTRA_CPPFLAGS="-DT_CLIMB_MS=5000 -DT_HOVER_MS=1000 -DT_DESCEND_MS=5000 -DFLIGHT_MAX_MS=15000 -DARM_MAX_TILT_RAD=0.087f -DROSE_TELEM_CONSOLE=0 -DFLOW_LP_TAU_X=0.05f -DFLOW_LP_TAU_Y=0.15f -DVL53L1X_TIMING_BUDGET_US=100000 -DIMU_OFFSET_Y=0.016f -DSAFE_MAX_HEIGHT_M=2.2f -DTOF_STEP_REJECT_M=0.25f -DPITCH_TRIM_RAD=0.045f -DBATT_NOMINAL_V=3.8f -DBATT_ARM_MIN_V=3.95f -DATT_GAIN=0.85f -DALT_INT_BAND=0.10f -DSAFE_MAX_VEL_MPS=2.0f -DBATT_CUTOFF_V=3.0f -DYAW_AUTH_FRAC=0.15f -DROSE_VEL_LOOP=1 -DVEL_TILT_MAX=0.08f -DMOTOR_TRIM_LEFT=1.0f"
