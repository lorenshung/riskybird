# RiskyBird flight preset 't33-hover-1.5m' -- the build knobs that flew: T122 (2026-09-25) full profile to 1.53 m and a self-landing, the best flight since 09-24; earlier T98 3.3 s to 1.0 m (dashboard ESTOP), banked -2.2 deg mean from liftoff, slid +y ~0.8 m -- T21's flight control exactly (the vertical takeoff), at 1.5 m, with only safety-only additions
# Source: flight-logs T96/T97 (2026-09-25): "I want vertical stable takeoff as we've achieved before." Built FROM
# t21-hover-1.0m, not from t32. Control knobs identical to T21: no roll/pitch trim (t30's +0.05 rad roll trim leans
# the frame at liftoff, below ALT_INT_GROUND_M where the velocity loop cannot answer it), FLOW_LP_TAU_X 0.05,
# YAW_AUTH_FRAC 0.15, no FLOW_GYRO_LP_MATCH. Changed from t21, and nothing else:
#   HOVER_Z_M 1.00 -> 1.50, T_CLIMB/T_DESCEND 3500 -> 5000 ms (same ~0.3 m/s), T_HOVER 2000 -> 1000 ms
#   FLIGHT_MAX_MS 20000, SAFE_MAX_HEIGHT_M 2.2, ROSE_COMMIT_MAX_MS 300000, BATT_ARM_MIN_V 3.95
#   safety-only (act only when a guard trips / over a floor step / at touchdown): TOF_STEP_REJECT_M 0.25, free-fall
#   low-pass (t28), yaw-spin cutoff (t29), soft land + low-passed velocity guard (t31), LAND_Z_THRESH_M 0.12 (t32)
# Build: rb fly commit --mode t33-hover-1.5m (or rb build flight_controller --target arty200t --mode t33-hover-1.5m).
export RB_CMAKE_ARGS="-DROSE_AUTOFLIGHT=1 -DROSE_ARM_NO_GESTURE=1 -DROSE_UART_CMD=1 -DROSE_FLIGHT_COMMIT=1 -DROSE_COMMIT_MAX_MS=300000 -DAUTOFLIGHT_MAX_DUTY=0.95f -DPID_MASS_KG=0.050f -DARM_MAX_HEIGHT_M=0.05f -DHOVER_Z_M=1.50f -DROSE_TELEM_DIV=40 -DROSE_BATT_REPORT_ONLY=0"
export RB_EXTRA_CPPFLAGS="-DT_CLIMB_MS=5000 -DT_HOVER_MS=1000 -DT_DESCEND_MS=5000 -DFLIGHT_MAX_MS=20000 -DARM_MAX_TILT_RAD=0.087f -DROSE_TELEM_CONSOLE=0 -DFLOW_LP_TAU_X=0.05f -DFLOW_LP_TAU_Y=0.15f -DVL53L1X_TIMING_BUDGET_US=100000 -DIMU_OFFSET_Y=0.016f -DSAFE_MAX_HEIGHT_M=2.2f -DATT_GAIN=0.85f -DALT_INT_BAND=0.10f -DSAFE_MAX_VEL_MPS=2.0f -DBATT_CUTOFF_V=3.0f -DYAW_AUTH_FRAC=0.15f -DROSE_VEL_LOOP=1 -DVEL_TILT_MAX=0.08f -DMOTOR_TRIM_LEFT=1.0f -DBATT_ARM_MIN_V=3.95f -DTOF_STEP_REJECT_M=0.25f -DSAFE_FREEFALL_LP_TAU_MS=80 -DSAFE_FREEFALL_DEBOUNCE_MS=100 -DSAFE_MAX_YAW_RATE_RADPS=1.5f -DSAFE_YAW_LP_TAU_MS=80 -DSAFE_YAW_DEBOUNCE_MS=200 -DSAFE_SOFT_LAND=1 -DSAFE_SOFT_LAND_MIN_Z=0.30f -DLAND_ABORT_MPS=0.30f -DSAFE_VEL_LP_TAU_MS=300 -DLAND_Z_THRESH_M=0.12f"
