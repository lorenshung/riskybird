-case class TacitBPParams(xlen: Int, n_entries: Int)
+// `enable` gates ELABORATION of the predictor, not a runtime mode.
+//
+// The predictor only ever feeds TacitEncoder's BrPredict path (`bp_mode === 2`).
+// The mode register resets to 0 (BrTarget) and no software in the PYNQ-Z1 tutorial
+// writes it, so on that platform the predictor is 1024 x 2 bits of flops and a
+// 1024:1 mux whose output reaches nothing.  With `enable = false` TacitEncoder does
+// not instantiate it at all and hard-wires itself to BrTarget; with `enable = true`
+// (the default, so every existing call site is unchanged) BrPredict still works.
+case class TacitBPParams(xlen: Int, n_entries: Int, enable: Boolean = true)
 
 class DSCBranchPredictor(params: TacitBPParams) extends Module {
   val io = IO(new Bundle {
